<%# The view with this issue at the top: the project screen narrowed to this issue and
    its branches, in a frame under the description. Only for an issue that has branches. It is folded at first, so the
    issue page keeps Redmine's usual look; the frame is loaded when it is opened. Whether it is open is remembered per
    browser (a convenience: it is folded when there is no storage). %>
<% if @project&.module_enabled?(:sequential_tasks) && User.current.allowed_to?(:view_sequential_tasks, @project) &&
      SequentialTaskIssue.where(branched_from_issue_id: @issue.id).exists? %>
  <details class="sq-root-view" style="margin: 12px 0;">
    <summary style="cursor: pointer; font-weight: bold;"><%= l('sequential_tasks.root_view.title') %></summary>
    <iframe class="sq-root-frame" title="<%= l('sequential_tasks.root_view.title') %>"
            data-src="<%= project_sequential_tasks_path(@project, root: @issue.id, sq_embed: 1) %>"
            style="width: 100%; height: 240px; border: 1px solid #e2e8f0; border-radius: 4px; background: #fff; margin-top: 6px;"></iframe>
  </details>
  <script>
    (function () {
      var box = document.currentScript.previousElementSibling;
      var frame = box.querySelector('iframe');
      var fit = function () { // as tall as the view inside (it cannot be measured while the box is folded)
        try { var d = frame.contentDocument.documentElement; if (d.scrollHeight > 0) frame.style.height = (d.scrollHeight + 2) + 'px'; } catch (e) {}
      };
      var show = function () { // the frame is loaded the first time the box is open
        if (!frame.getAttribute('src')) frame.setAttribute('src', frame.getAttribute('data-src'));
        else fit();
      };
      frame.addEventListener('load', fit);
      try { if (window.localStorage.getItem('sqRootViewOpen') === '1') box.open = true; } catch (e) {}
      if (box.open) show();
      box.addEventListener('toggle', function () {
        try { window.localStorage.setItem('sqRootViewOpen', box.open ? '1' : '0'); } catch (e) {}
        if (box.open) show();
      });
    })();
  </script>
<% end %>
