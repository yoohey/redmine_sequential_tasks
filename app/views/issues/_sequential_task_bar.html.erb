<%
  # Only where the module is on (its buttons would answer 403 elsewhere; review 2026-11-14)
  setting = @issue.project&.module_enabled?(:sequential_tasks) ? SequentialTaskSetting.find_by(tracker_id: @issue.tracker_id, enabled: true) : nil
  if setting
    stages = @issue.issue_stages.includes(:status).to_a

    if stages.empty? && setting.steps.any?
      # An issue without stage records (created before the tracker was set up): a plan drawn from the settings, in
      # working days like the server's (it cannot be adjusted: there is nothing to save it to)
      calc = RedmineSequentialTasks::WorkingDayCalculator
      steps = setting.steps.to_a
      current_position = steps.find { |st| st.status_id == @issue.status_id }&.position || 0
      cur_d = (calc.next_working_day(@issue.start_date || User.current.today) rescue (@issue.start_date || User.current.today)) # rubocop:disable Style/RescueModifier
      standard_days = RedmineSequentialTasks::StandardDays.new(@issue.project_id)
      stages = steps.each_with_index.map do |step, step_index|
        step_days = standard_days.days(@issue.tracker_id, step)
        zero_day = step_index.zero? && step_days <= 0 # a wait for somebody to pick the issue up
        end_d = zero_day ? cur_d : (calc.end_date_for(cur_d, step_days) rescue cur_d) # rubocop:disable Style/RescueModifier
        s_status = if step.status_id == @issue.status_id then 'in_progress'
                   elsif step.position < current_position then 'completed'
                   else 'pending'
                   end
        stage = IssueStage.new(
          issue_id: @issue.id,
          status_id: step.status_id,
          position: step.position,
          planned_start_date: cur_d,
          planned_end_date: end_d,
          actual_start_at: (s_status == 'in_progress' || s_status == 'completed') ? cur_d.to_time : nil,
          actual_end_at: (s_status == 'completed') ? end_d.to_time : nil,
          stage_status: s_status,
          zero_day: zero_day
        )
        cur_d = (calc.next_stage_start_date(end_d) rescue end_d + 1) unless zero_day # rubocop:disable Style/RescueModifier
        stage
      end
    end

    today = User.current.today
    # Overall state shared with the timeline and matrix screens
    summary = RedmineSequentialTasks::ProgressSummary.new(@issue, stages.to_a, today)
    expected_stage = summary.expected_stage
    current_stage = summary.current_stage
    is_behind = summary.delayed?
    is_ahead = summary.ahead?
    # Which stages the schedule adjustment may change
    rescheduler = RedmineSequentialTasks::StageRescheduler.new(stages.to_a, @issue.closed? ? nil : summary.schedule_anchor)
    # the one adjustable stage right before the due date; it absorbs the change in "fixed_due" mode
    adjustable_stages = stages.to_a.select { |s| rescheduler.adjustable?(s) }
    slack_stage = adjustable_stages.size > 1 ? adjustable_stages.last : nil
    can_adjust_schedule = User.current.allowed_to?(:edit_issues, @issue.project)
    # no working day within about half a year: the plan cannot be built, so there is no adjusting
    schedulable = RedmineSequentialTasks::WorkingDayCalculator.schedulable?(today)
    # a plan drawn from the settings for an issue without stage records cannot be saved: no adjusting there
    stages_saved = stages.first.respond_to?(:persisted?) && stages.first.persisted?
    days_behind = summary.delay_days
    diff_text = nil

    if is_behind
      if expected_stage && current_stage.position < expected_stage.position
        diff_text = l('sequential_tasks.issue_bar.behind_expected', stage: expected_stage.status&.name, days: days_behind)
      else
        diff_text = l('sequential_tasks.issue_bar.over_end', stage: current_stage.status&.name, days: days_behind)
      end
    elsif is_ahead
      diff_text = l('sequential_tasks.issue_bar.ahead_text', stage: current_stage.status&.name)
    end

    step_colors = setting ? setting.steps.pluck(:status_id, :color).to_h : {}
    default_palette = %w[#3b82f6 #f59e0b #10b981 #8b5cf6 #ec4899 #06b6d4]

    # Safe lookup for loose branch metadata
    # Both helpers return only issues visible to the current user
    parent_issue = @issue.branched_from_issue
    branched_issues = @issue.visible_branched_issues
%>
<%= stylesheet_link_tag 'sequential_tasks', plugin: 'redmine_sequential_tasks' %>
<div class="sequential-task-container" id="sq-stage-timeline" <%= RedmineSequentialTasks::DateFormat.data_attributes.map { |k, v| %(#{k}="#{h(v)}") }.join(' ').html_safe %> data-t-discard="<%= l('sequential_tasks.stage_form.discard_confirm') %>" data-non-working="<%= RedmineSequentialTasks::WorkingDayCalculator.non_working_week_days.to_json %>">
  <div class="sqb-head">
    <div class="sqb-title">
      <span class="sqb-dot<%= ' sqb-dot-late' if is_behind %>"></span>
      <%= l('sequential_tasks.issue_bar.heading') %>

      <% if parent_issue %>
        <span class="sqb-origin">
          🌿 <%= l('sequential_tasks.issue_bar.origin') %> <%= link_to "##{parent_issue.id} #{parent_issue.subject}", issue_path(parent_issue) %>
          <span class="sqb-origin-status">(<%= parent_issue.status.name %>)</span>
        </span>
      <% end %>

      <% if is_behind %>
        <!-- Alarm badge when not reached the expected stage -->
        <span class="sqb-diff sqb-diff-behind">
          <%= diff_text %>
        </span>
      <% elsif is_ahead %>
        <span class="sqb-diff sqb-diff-ahead">
          <%= diff_text %>
        </span>
      <% end %>
    </div>
    <div class="sqb-tools">
      <% if slack_stage && can_adjust_schedule && rescheduler.adjustable_any? && schedulable && stages_saved %>
        <%# The mode of the adjustment, in the heading row and only while adjusting; it lives outside the
            form below, so its radios join it through the form attribute (form.reset() resets them too) %>
        <div id="stage-mode-switch">
          <label title="<%= l('sequential_tasks.stage_form.mode_fixed_due_hint') %>" data-hint="<%= l('sequential_tasks.stage_form.mode_fixed_due_hint') %>">
            <input type="radio" name="mode" value="fixed_due" form="sequential-task-stage-edit-form" checked><%= l('sequential_tasks.stage_form.mode_fixed_due') %>
          </label>
          <label title="<%= l('sequential_tasks.stage_form.mode_push_hint') %>" data-hint="<%= l('sequential_tasks.stage_form.mode_push_hint') %>">
            <input type="radio" name="mode" value="push" form="sequential-task-stage-edit-form"><%= l('sequential_tasks.stage_form.mode_push') %>
          </label>
        </div>
      <% end %>
      <span><%= l('sequential_tasks.issue_bar.due_date') %>: <strong><%= @issue.due_date ? RedmineSequentialTasks::DateFormat.full(@issue.due_date) : (stages.last&.planned_end_date ? RedmineSequentialTasks::DateFormat.full(stages.last.planned_end_date) : l('sequential_tasks.journal.unset')) %></strong></span>

      <% if User.current.allowed_to?(:edit_issues, @issue.project) %>
        <% if rescheduler.adjustable_any? && schedulable && stages_saved %>
        <button type="button" data-sq-act="adjust" class="sqb-btn sq-adjust-toggle" aria-expanded="false">
          <span>📅 <%= l('sequential_tasks.issue_bar.adjust') %></span>
        </button>
        <% end %>

        <button type="button" data-sq-act="branch" class="sqb-btn sqb-btn-branch">
          <span>+🌿 <%= l('sequential_tasks.issue_bar.create_branch') %></span>
        </button>
      <% end %>
    </div>
  </div>

  <% unless schedulable %>
    <div class="sqb-banner sq-no-working-day">
      ⚠ <%= l('sequential_tasks.flash.no_working_day') %>
    </div>
  <% end %>
  <% if summary.out_of_stage? %>
    <%# 30px below: the date callouts stand above the bar (top: -26px) and would cover a banner right above it %>
    <div class="sqb-banner sqb-banner-oos">
      ⚑ <%= current_stage ? l('sequential_tasks.out_of_stage.banner', status: @issue.status.name, stage: current_stage.status&.name) : l('sequential_tasks.out_of_stage.banner_no_stage', status: @issue.status.name) %>
    </div>
  <% end %>

  <!-- Stage Pipeline Bar with Boundary Milestone Dates: the one surface for both looking at the plan and (if
       editable) changing it -- dragging a boundary, or typing into the day count shown inside a stage,
       does the same thing; there is no separate list of stages elsewhere on the screen.
       Each stage box is as wide as its contents need without wrapping (its "base", measured once by the script
       below, with and without the edit controls) plus SQ_STAGE_DAY_PX for every day after the first:
       a 1-day stage is just wide enough, and each extra day visibly adds a little. The width is absolute, so in
       "push" mode growing a stage really lengthens the whole bar; in "fixed_due" mode the adjustable stages'
       days add up to a constant, so their widths do too and the right edge (the due date) stays where it is
       without any other trick. #stage-adjustable-group only groups them now. -->
  <% editable_screen = can_adjust_schedule && rescheduler.adjustable_any? && schedulable && stages_saved %>
  <%# The start date can be moved here only while no stage has finished (the same rule as on the project timeline) %>
  <% start_workflow_ok = @issue.safe_attribute?('start_date', User.current) %>
  <% start_changeable = editable_screen && rescheduler.start_changeable? && start_workflow_ok %>
  <%# Otherwise the box is shown grayed out, with the reason; a disabled box is not sent %>
  <% start_locked_reason = start_changeable ? nil : l(start_workflow_ok ? 'sequential_tasks.stage_form.start_locked' : 'sequential_tasks.stage_form.start_locked_workflow') %>
  <% first_adjustable_id = adjustable_stages.first&.id %>
  <% last_adjustable_id = adjustable_stages.last&.id %>
  <% open_group = adjustable_stages.size > 1 %>
  <%= form_tag(issue_sequential_task_stages_path(@issue.id), method: :put, id: 'sequential-task-stage-edit-form') do %>
    <%= hidden_field_tag :sq_float, '1', id: nil if params[:sq_float] == '1' %>
    <div id="stage-pipeline-bar" data-orig-due="<%= stages.last&.planned_end_date&.strftime('%Y-%m-%d') %>" data-t-working="<%= l('sequential_tasks.issue_bar.working_days') %>" data-t-all-days="<%= l('sequential_tasks.issue_bar.all_days_unit') %>" class="sq-style-<%= RedmineSequentialTasks::BarStyle.normalize(setting.bar_style) %>">
      <%# A stage of zero days gets no box, as on the project's timeline; it is never adjustable %>
      <% shown_stages = stages.reject { |s| s.respond_to?(:zero_day) && s.zero_day } %>
      <% shown_stages.each_with_index do |stage, idx|
           st_name = stage.status&.name || IssueStatus.find_by(id: stage.status_id)&.name || l('sequential_tasks.issue_bar.unknown_stage')
           is_skipped = (stage.stage_status == 'skipped')
           box_days = (stage.planned_start_date && stage.planned_end_date) ? [RedmineSequentialTasks::WorkingDayCalculator.days_between(stage.planned_start_date, stage.planned_end_date, stage.all_days?), 1].max : 1
           is_adjustable_box = rescheduler.adjustable?(stage)
           is_slack_box = stage == slack_stage
           # current_stage also covers a status without a stage
           is_cur = !is_skipped && !current_stage.nil? && (stage == current_stage) && !summary.not_started_stage?(stage) # before the start date: planned
           is_done = !is_skipped && (stage.stage_status == 'completed' || (!is_cur && current_stage && stage.position < current_stage.position))
           is_delayed = is_cur && is_behind
           is_expected_today = (stage == expected_stage)

           base_color = step_colors[stage.status_id] || default_palette[(stage.position - 1) % default_palette.size]
           base_color = SequentialTaskStep::DEFAULT_COLOR unless base_color.to_s.match?(SequentialTaskStep::COLOR_FORMAT) # it goes into style attributes

           # The same state classes and colors as the bars of the project's timeline (sequential_tasks.css)
           bar_kind, glyph, badge_text =
             if is_skipped then ['skipped', '- ', l('sequential_tasks.state.skipped')]
             elsif is_delayed then ['delayed', '⚠️ ', l('sequential_tasks.state.delayed', days: days_behind)]
             elsif is_done then ['done', '✓ ', l('sequential_tasks.state.closed')]
             elsif is_cur then ['cur', '▶ ', l('sequential_tasks.state.current')]
             else ['future', '', l('sequential_tasks.state.planned')]
             end
      %>
        <% if open_group && stage.id == first_adjustable_id %>
          <div id="stage-adjustable-group">
        <% end %>
        <!-- Stage Box: its own no-wrap width + 10px per day after the first (set by sequential_task_bar.js) -->
        <div class="stage-drag-seg sq-bar-<%= bar_kind %>" data-stage-id="<%= stage.id %>" data-all-days="<%= stage.all_days? ? '1' : '0' %>" data-fixed="<%= is_adjustable_box ? '0' : '1' %>" data-slack="<%= is_slack_box ? '1' : '0' %>"
             data-orig-duration="<%= box_days %>" data-start="<%= stage.planned_start_date&.strftime('%Y-%m-%d') %>" data-end="<%= stage.planned_end_date&.strftime('%Y-%m-%d') %>"
             style="--c: <%= base_color %>;">
          <% if editable_screen && is_adjustable_box %>
            <div class="stage-drag-handle<%= ' stage-drag-handle-slack' if is_slack_box %>" data-stage-id="<%= stage.id %>" title="<%= l('sequential_tasks.stage_form.drag_hint') %>"
                 <%= raw ' style="visibility: hidden;"' if is_slack_box %>>
              <div class="stage-drag-grip"></div>
            </div>
          <% end %>
          <!-- Stage Name & Badge -->
          <div class="sqb-stage-head">
            <span class="sqb-stage-name"><%= glyph %><%= st_name %></span>
            <span class="sq-stage-badge"><%= badge_text %></span>
          </div>

          <!-- Duration: plain text normally; while adjusting, an adjustable stage's own duration is an editable
               box right here -- there is no separate list of stages elsewhere on the screen. -->
          <div class="sq-stage-days">
              <span class="stage-duration-static"><%= l(stage.all_days? ? 'sequential_tasks.issue_bar.duration_all_days' : 'sequential_tasks.issue_bar.duration', days: box_days) %></span>
              <% if editable_screen && is_adjustable_box %>
                <span class="stage-duration-edit">
                  <input type="number" name="stages[<%= stage.id %>][duration_days]" class="stage-duration-input" value="<%= box_days %>"
                         min="1" max="365" inputmode="numeric" aria-label="<%= l('sequential_tasks.stage_form.days_label', stage: st_name) %>">
                  <span class="stage-days-unit"><%= l(stage.all_days? ? 'sequential_tasks.issue_bar.all_days_unit' : 'sequential_tasks.issue_bar.working_days') %></span>
                </span>
                <%# this stage counts the non-working days too (e.g. recovered on a weekend); its own line, so the box
                    does not get wider. The hidden 0 is sent when the box is not ticked %>
                <label class="stage-all-days-edit" title="<%= l('sequential_tasks.stage_form.count_non_working_title') %>">
                  <input type="hidden" name="stages[<%= stage.id %>][count_non_working]" value="0">
                  <input type="checkbox" name="stages[<%= stage.id %>][count_non_working]" value="1" class="stage-all-days"<%= ' checked' if stage.all_days? %> aria-label="<%= l('sequential_tasks.stage_form.count_non_working_label', stage: st_name) %>"><%= l('sequential_tasks.stage_form.count_non_working') %>
                </label>
                <% if is_slack_box %>
                  <%# Only when the other stages leave this one no day before the due date (fixed_due mode); the mode switch itself says the rest.
                      Just under the box, out of the flow, so it does not widen the box (its width is its content's) %>
                  <span class="stage-slack-note"><%= l('sequential_tasks.stage_form.cannot_fit_hint') %></span>
                <% end %>
              <% end %>
          </div>

          <!-- Start Marker at the left edge of the first box: planned start and actual start. Left-aligned
               (its tick on the edge) so it does not stick out past the left of the box around the bar. -->
          <% if idx.zero? %>
            <%
              start_planned_d = stage.planned_start_date
              start_actual_d = summary.not_started_stage?(stage) ? nil : RedmineSequentialTasks::UserTime.date_of(stage.actual_start_at)
              start_diff = (start_actual_d && start_planned_d) ? (start_actual_d - start_planned_d).to_i : nil
            %>
            <div id="stage-start-pill" class="sqb-pill">
              <div class="sqb-pill-box">
                <div class="sqb-pill-plan">
                  <%= l('sequential_tasks.table.planned_label') %> <span class="stage-start-date"><%= start_planned_d ? RedmineSequentialTasks::DateFormat.short(start_planned_d) : '-' %></span>
                </div>
                <% if start_actual_d %>
                  <div class="sqb-pill-actual<%= ' sqb-late' if start_diff && start_diff > 0 %>">
                    <%= l('sequential_tasks.table.actual_label') %> <%= RedmineSequentialTasks::DateFormat.short(start_actual_d) %>
                    <% if start_diff && start_diff > 0 %>
                      <span class="sqb-pill-diff">(+<%= start_diff %>d)</span>
                    <% elsif start_diff && start_diff < 0 %>
                      <span class="sqb-pill-diff">(<%= start_diff %>d)</span>
                    <% end %>
                  </div>
                <% else %>
                  <div class="sqb-pill-none">
                    <%= l('sequential_tasks.issue_bar.actual_not_yet') %>
                  </div>
                <% end %>
              </div>
              <div class="sqb-tick"></div>
            </div>
          <% end %>

          <!-- Boundary Milestone Marker at the right edge of stage (between stages); live-updated while adjusting -->
          <% if idx < shown_stages.size - 1 %>
            <%
              boundary_planned_d = stage.planned_end_date
              boundary_actual_d = RedmineSequentialTasks::UserTime.date_of(stage.actual_end_at)

              # Milestone variance (difference between planned and actual exit date)
              diff_days = (boundary_actual_d && boundary_planned_d) ? (boundary_actual_d - boundary_planned_d).to_i : nil
            %>
            <div id="stage-plan-pill-<%= stage.id %>" class="sqb-pill sqb-pill-boundary">
              <!-- Pill with Planned and Actual Dates Stacked -->
              <div class="sqb-pill-box">
                <div class="sqb-pill-plan">
                  <%= l('sequential_tasks.table.planned_label') %> <span class="stage-plan-date"><%= boundary_planned_d ? RedmineSequentialTasks::DateFormat.short(boundary_planned_d) : '-' %></span>
                </div>
                <% if boundary_actual_d %>
                  <div class="sqb-pill-actual<%= ' sqb-late' if diff_days && diff_days > 0 %>">
                    <%= l('sequential_tasks.table.actual_label') %> <%= RedmineSequentialTasks::DateFormat.short(boundary_actual_d) %>
                    <% if diff_days && diff_days > 0 %>
                      <span class="sqb-pill-diff">(+<%= diff_days %>d)</span>
                    <% elsif diff_days && diff_days < 0 %>
                      <span class="sqb-pill-diff">(<%= diff_days %>d)</span>
                    <% end %>
                  </div>
                <% else %>
                  <div class="sqb-pill-none">
                    <%= l('sequential_tasks.issue_bar.actual_not_yet') %>
                  </div>
                <% end %>
              </div>
              <!-- Downward pointing tick -->
              <div class="sqb-tick"></div>
            </div>
          <% end %>
        </div>

        <% if idx < shown_stages.size - 1 %>
          <!-- Small separator space between boxes -->
          <div class="sqb-gap"></div>
        <% end %>
        <% if open_group && stage.id == last_adjustable_id %>
          </div><!-- /#stage-adjustable-group -->
        <% end %>
      <% end %>

      <!-- Due-date callout: lives outside the loop, pinned to the bar's own right edge; updated live while adjusting -->
      <div id="stage-due-pill" class="sqb-pill">
        <div class="sqb-pill-box">
          <%= l('sequential_tasks.issue_bar.due_date') %>: <span class="stage-due-date"><%= @issue.due_date ? RedmineSequentialTasks::DateFormat.short(@issue.due_date) : (RedmineSequentialTasks::DateFormat.short(stages.last&.planned_end_date) || '-') %></span>
        </div>
        <div class="sqb-tick"></div>
      </div>
    </div>

    <% if editable_screen %>
      <!-- Controls (Collapsible): mode switch, the new due date, cancel/save. No frame or heading of their own:
           they belong to the stage timeline above, which is the only place a day count is shown or typed. -->
      <div id="stage-edit-controls">
        <div class="sqb-controls-row">
          <% if editable_screen %>
            <%# A callout pointing up at the left end of the bar, which is the start %>
            <label class="sq-start-bubble<%= ' sq-start-locked' unless start_changeable %>" title="<%= start_locked_reason %>">
              <%= l('sequential_tasks.stage_form.start_date') %>
              <input type="date" name="start_date" id="stage-start-input" value="<%= stages.first.planned_start_date&.strftime('%Y-%m-%d') %>"
                     <%= 'disabled' unless start_changeable %> aria-describedby="stage-start-why">
              <%# the reason, short and on screen while it is grayed out (not only on hover: touch and keyboard) %>
              <% unless start_changeable %><span id="stage-start-why" class="sq-start-why">🔒 <%= l(start_workflow_ok ? 'sequential_tasks.stage_form.start_locked_short' : 'sequential_tasks.stage_form.start_locked_workflow_short') %></span><% end %>
            </label>
          <% end %>
          <div class="sqb-total">
            <%= l('sequential_tasks.stage_form.total_due') %>: <strong id="preview-total-due-date"><%= stages.last&.planned_end_date ? RedmineSequentialTasks::DateFormat.full(stages.last.planned_end_date) : '-' %></strong>
          </div>
          <div class="sqb-actions">
            <button type="button" data-sq-act="adjust" class="sqb-cancel">
              <%= l(:button_cancel) %>
            </button>
            <span id="stage-cannot-fit" class="sq-cannot-fit" hidden><%= l('sequential_tasks.stage_form.cannot_fit_hint') %></span>
            <button type="submit" id="stage-save-button" class="sq-stage-save">
              💾 <%= l('sequential_tasks.stage_form.save') %>
            </button>
          </div>
        </div>
        <%# the selected mode in words (not only on hover), then how to adjust; read out when the mode changes %>
        <p class="sqb-hint"><span id="stage-mode-hint" aria-live="polite"></span> <%= l('sequential_tasks.stage_form.drag_bar_hint') %> <%= l('sequential_tasks.stage_form.esc_hint') %></p>
      </div>
    <% end %>
  <% end %>

  <!-- Branched Issues List (Children) -->
  <% if branched_issues.any? %>
    <div class="sqb-branches">
      <span class="sqb-branches-head">
        🌿 <%= l('sequential_tasks.issue_bar.branches_heading', count: branched_issues.size) %>
      </span>
      <% branched_issues.each do |bi| %>
        <span class="sqb-branch">
          <%= link_to "##{bi.id} #{bi.subject}", issue_path(bi) %>
          <span class="sqb-branch-status">
            <%= bi.status.name %>
          </span>
          <% if bi.assigned_to %>
            <span class="sqb-branch-assignee">(<%= bi.assigned_to.name %>)</span>
          <% end %>
        </span>
      <% end %>
    </div>
  <% end %>

  <!-- Loose Branch Task Creation Panel (Collapsible) -->
  <% if User.current.allowed_to?(:add_issues, @issue.project) %>
    <div id="branch-create-form-panel">
      <%= form_tag(issue_sequential_task_branches_path(@issue.id), method: :post) do %>
        <%= hidden_field_tag :back_url, issue_path(@issue, params[:sq_float] == '1' ? { sq_float: 1 } : {}) %>
        <div class="sqb-form-head">
          <span>🌿 <%= l('sequential_tasks.issue_bar.branch_form_heading') %></span>
          <span class="sqb-form-note">
            <%= l('sequential_tasks.issue_bar.branch_form_note') %>
          </span>
        </div>

        <div class="sqb-form-fields">
          <div class="sqb-field sqb-field-wide">
            <label><%= l(:field_subject) %></label>
            <% next_b_num = branched_issues.size + 1 %>
            <%= text_field_tag :subject, "#{@issue.subject}_#{next_b_num}",
                               id: "panel-branch-subject" %>
          </div>

          <div class="sqb-field">
            <label><%= l(:field_tracker) %></label>
            <%= select_tag :tracker_id,
                           options_from_collection_for_select(@issue.project.trackers, :id, :name, @issue.tracker_id) %>
          </div>

          <div class="sqb-field">
            <label><%= l(:field_assigned_to) %></label>
            <%= select_tag :assigned_to_id,
                           options_from_collection_for_select(@issue.project.assignable_users, :id, :name, @issue.assigned_to_id),
                           include_blank: l('sequential_tasks.issue_bar.include_blank_unassigned') %>
          </div>

          <div class="sqb-field">
            <label><%= l(:field_start_date) %></label>
            <%= date_field_tag :start_date, SequentialTaskIssue.default_start_date(@issue) %>
          </div>
        </div>

        <div class="sqb-form-actions">
          <button type="button" data-sq-act="branch" class="sqb-cancel">
            <%= l(:button_cancel) %>
          </button>
          <button type="submit" class="sqb-submit">
            🌿 <%= l('sequential_tasks.issue_bar.create_branch') %>
          </button>
        </div>
      <% end %>
    </div>
  <% end %>


  <%# The behavior (sizes of the boxes, adjusting): sequential_task_bar.js, with the shared date calculation; no inline
      script (review 2026-11-14). After the bar, so it can measure it. %>
  <%= javascript_include_tag 'sequential_dates', 'sequential_task_bar', plugin: 'redmine_sequential_tasks' %>
</div>
<% end %>
