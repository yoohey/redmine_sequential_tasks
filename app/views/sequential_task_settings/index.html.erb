<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'sequential_tasks', plugin: 'redmine_sequential_tasks' %>
<% end %>
<div class="sq-settings">
<h2><%= l('sequential_tasks.menu.admin_settings') %></h2>

<p class="sq-help"><%= raw l('sequential_tasks.settings.index_help_html') %></p>

<table class="list">
  <thead>
    <tr>
      <th><%= l('sequential_tasks.settings.col_tracker') %></th>
      <th><%= l('sequential_tasks.settings.col_managed') %></th>
      <th><%= l('sequential_tasks.settings.col_flow') %></th>
      <th><%= l('sequential_tasks.settings.col_action') %></th>
    </tr>
  </thead>
  <tbody>
    <% @trackers.each do |tracker| %>
      <% setting = @settings[tracker.id] %>
      <% is_enabled = setting&.enabled? %>
      <% has_steps = setting && setting.steps.any? %>
      <tr>
        <td class="sq-tracker-name"><%= tracker.name %></td>
        <td>
          <%= form_tag(enabled_sequential_task_setting_path(tracker.id), method: :patch, class: 'sq-enable-form') do %>
            <label class="sq-enable-chip<%= ' sq-on' if is_enabled %><%= ' sq-locked' unless has_steps || is_enabled %>" title="<%= (has_steps || is_enabled) ? l('sequential_tasks.settings.enable_label') : l('sequential_tasks.settings.cannot_enable_without_stages') %>">
              <%= check_box_tag 'enabled', '1', is_enabled, id: "enabled_#{tracker.id}", disabled: !(has_steps || is_enabled), data: (is_enabled ? { confirm: l('sequential_tasks.settings.confirm_disable', tracker: tracker.name) } : {}) %>
              <%= l(is_enabled ? 'sequential_tasks.settings.enabled' : 'sequential_tasks.settings.disabled') %>
            </label>
          <% end %>
        </td>
        <td>
          <% if has_steps %>
            <div class="sq-flow">
              <% setting.steps.each_with_index do |step, idx| %>
                <span class="sq-flow-step"><strong><%= step.status&.name %></strong> <span class="sq-flow-days"><%= l('sequential_tasks.settings.days', days: step.default_duration_days) %></span></span>
                <% if idx < setting.steps.size - 1 %><span class="sq-flow-arrow">➔</span><% end %>
              <% end %>
            </div>
          <% else %>
            <span class="sq-not-set"><%= l('sequential_tasks.settings.not_set') %></span>
          <% end %>
        </td>
        <td><%= link_to l('sequential_tasks.settings.edit'), edit_sequential_task_setting_path(tracker.id), class: 'icon icon-edit' %></td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>
<%= javascript_include_tag 'sequential_task_settings', plugin: 'redmine_sequential_tasks' %>
