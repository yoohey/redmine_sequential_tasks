<td class="sq-col-color">
  <span class="sq-swatches" role="group" aria-label="<%= l('sequential_tasks.settings.col_color') %>">
    <% SequentialTaskStep::PALETTE.each_with_index do |c, i| %>
      <button type="button" class="sq-swatch" data-color="<%= c %>" aria-pressed="<%= c.casecmp?(color) %>" <%= 'disabled' if local_assigns[:disabled] %> title="<%= l('sequential_tasks.settings.swatch_label', n: i + 1, color: c) %>" aria-label="<%= l('sequential_tasks.settings.swatch_label', n: i + 1, color: c) %>"></button>
    <% end %>
  </span>
  <input type="color" class="sq-color-input" <%= 'disabled' if local_assigns[:disabled] %> name="steps[][color]" value="<%= color %>" title="<%= l('sequential_tasks.settings.custom_color') %>" aria-label="<%= l('sequential_tasks.settings.custom_color') %>">
</td>
