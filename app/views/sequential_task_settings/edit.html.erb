<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'sequential_tasks', plugin: 'redmine_sequential_tasks' %>
<% end %>
<div class="sq-settings">
<h2><%= l('sequential_tasks.settings.title_for', tracker: @tracker.name) %></h2>

<%= form_tag(sequential_task_setting_path(@tracker.id), method: :put, id: 'sequential-task-setting-form') do %>
  <div class="box tabular">
    <p>
      <label for="enabled"><%= l('sequential_tasks.settings.enable_label') %></label>
      <%= check_box_tag 'enabled', '1', @setting.enabled?, id: 'enabled' %>
      <em class="info sq-enable-note"><%= l('sequential_tasks.settings.enable_note') %></em>
    </p>
  </div>

  <h3><%= l('sequential_tasks.settings.steps_heading') %></h3>
  <p class="sq-help"><%= raw l('sequential_tasks.settings.steps_help_html') %></p>

  <div class="sq-preview-head">
    <span><%= l('sequential_tasks.settings.preview') %></span>
    <%= hidden_field_tag 'bar_style', @bar_style, id: 'bar_style' %>
    <span id="sq-preview-style" role="group">
      <button type="button" data-style="light"><%= l('sequential_tasks.settings.preview_light') %></button>
      <button type="button" data-style="subtle"><%= l('sequential_tasks.settings.preview_chips') %></button>
      <button type="button" data-style="bold"><%= l('sequential_tasks.settings.preview_bars') %></button>
    </span>
  </div>
  <div id="sq-root"><div id="sq-preview" data-days="<%= l('sequential_tasks.settings.days', days: '__N__') %>" data-empty="<%= l('sequential_tasks.settings.preview_empty') %>"></div></div>

  <table id="steps-table" class="list">
    <thead>
      <tr>
        <th class="sq-col-use"><%= l('sequential_tasks.settings.col_use') %></th>
        <th class="sq-col-status"><%= l('sequential_tasks.settings.col_status') %></th>
        <th class="sq-col-days"><%= l('sequential_tasks.settings.col_days') %></th>
        <th class="sq-col-color"><%= l('sequential_tasks.settings.col_color') %></th>
      </tr>
    </thead>
    <tbody id="steps-tbody">
      <% @statuses.each do |st| %>
        <% step = @steps_by_status[st.id] %>
        <tr class="step-row <%= 'sq-off' unless step %>">
          <td class="sq-col-use">
            <span class="sq-handle" title="<%= l('sequential_tasks.settings.drag') %>">⠿</span>
            <input type="checkbox" name="steps[][status_id]" value="<%= st.id %>" class="sq-use" <%= 'checked' if step %> title="<%= l('sequential_tasks.settings.col_use') %>" aria-label="<%= l('sequential_tasks.settings.col_use') %>: <%= st.name %>">
          </td>
          <td class="sq-col-status">
            <span class="sq-status-name"><%= st.name %></span>
            <% unless @workflow_status_ids.include?(st.id) %>
              <em class="sq-not-in-workflow" title="<%= l('sequential_tasks.settings.not_in_workflow_title') %>"><%= l('sequential_tasks.settings.not_in_workflow') %></em>
            <% end %>
          </td>
          <td class="sq-col-days">
            <input type="number" class="sq-days-input" name="steps[][default_duration_days]" value="<%= step&.default_duration_days || 1 %>" min="0" max="365" <%= 'disabled' unless step %> aria-label="<%= l('sequential_tasks.settings.col_days') %>: <%= st.name %>"> <%= l('sequential_tasks.settings.days_unit') %>
          </td>
          <%= render 'color_cell', color: step&.color.presence || '#3498db', disabled: !step %>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @statuses.any? { |st| !@workflow_status_ids.include?(st.id) } %>
    <p class="sq-legend"><%= l('sequential_tasks.settings.not_in_workflow') %>: <%= l('sequential_tasks.settings.not_in_workflow_title') %></p>
  <% end %>

  <div class="sq-actions">
    <%= submit_tag l(:button_save), class: 'button-positive' %>
    <%= link_to l(:button_cancel), sequential_task_settings_path %>
  </div>
<% end %>
</div>
<%= javascript_include_tag 'sequential_task_settings', plugin: 'redmine_sequential_tasks' %>
