<h2><%= l('sequential_tasks.settings.title_for', tracker: @tracker.name) %></h2>

<%= form_tag(sequential_task_setting_path(@tracker.id), method: :put, id: 'sequential-task-setting-form') do %>
  <div class="box tabular" style="background: #ffffff; padding: 16px; border: 1px solid #cbd5e1; border-radius: 6px; margin-bottom: 20px;">
    <p>
      <label for="enabled" style="font-weight: bold; cursor: pointer;"><%= l('sequential_tasks.settings.enable_label') %></label>
      <%= check_box_tag 'enabled', '1', @setting.enabled?, id: 'enabled' %>
      <em class="info" style="color: #64748b; font-size: 12px; margin-left: 8px;">
        <%= l('sequential_tasks.settings.enable_note') %>
      </em>
    </p>
  </div>

  <h3><%= l('sequential_tasks.settings.steps_heading') %></h3>
  <p style="color: #64748b; font-size: 12px; margin-bottom: 12px;">
    <%= raw l('sequential_tasks.settings.steps_help_html') %>
  </p>

  <div style="margin: 0 0 6px; font-size: 12px; color: #64748b; display: flex; align-items: center; gap: 10px;">
    <span><%= l('sequential_tasks.settings.preview') %></span>
    <%= hidden_field_tag 'bar_style', @bar_style, id: 'bar_style' %>
    <span id="sq-preview-style" role="group" style="display: inline-flex; border: 1px solid #cbd5e1; border-radius: 4px; overflow: hidden;">
      <button type="button" data-style="light" style="border: 0; padding: 2px 10px; font-size: 11px; cursor: pointer;"><%= l('sequential_tasks.settings.preview_light') %></button>
      <button type="button" data-style="subtle" style="border: 0; border-left: 1px solid #cbd5e1; padding: 2px 10px; font-size: 11px; cursor: pointer;"><%= l('sequential_tasks.settings.preview_chips') %></button>
      <button type="button" data-style="bold" style="border: 0; border-left: 1px solid #cbd5e1; padding: 2px 10px; font-size: 11px; cursor: pointer;"><%= l('sequential_tasks.settings.preview_bars') %></button>
    </span>
  </div>
  <%= stylesheet_link_tag 'sequential_tasks', plugin: 'redmine_sequential_tasks' %>
  <div id="sq-root" style="margin-bottom: 14px;"><div id="sq-preview" data-days="<%= l('sequential_tasks.settings.days', days: '__N__') %>" data-empty="<%= l('sequential_tasks.settings.preview_empty') %>" style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px; min-height: 20px; padding: 8px 10px; background: #fff; border: 1px solid #e2e8f0; border-radius: 6px; font-size: 12px;"></div></div>

  <table id="steps-table" class="list" style="border-collapse: collapse; width: 100%; max-width: 750px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 6px;">
    <thead>
      <tr style="background: #f8fafc; border-bottom: 2px solid #cbd5e1; height: 36px;">
        <th style="width: 80px; text-align: center;"><%= l('sequential_tasks.settings.col_use') %></th>
        <th style="text-align: left; padding: 8px 12px;"><%= l('sequential_tasks.settings.col_status') %></th>
        <th style="width: 140px; text-align: left; padding: 8px 12px;"><%= l('sequential_tasks.settings.col_days') %></th>
        <th style="width: 190px; text-align: center; padding: 8px 12px;"><%= l('sequential_tasks.settings.col_color') %></th>
      </tr>
    </thead>
    <tbody id="steps-tbody">
      <% @statuses.each do |st| %>
        <% step = @steps_by_status[st.id] %>
        <tr class="step-row <%= 'sq-off' unless step %>" style="border-bottom: 1px solid #f1f5f9; height: 44px;">
          <td style="text-align: center; white-space: nowrap;">
            <span class="sq-handle" title="<%= l('sequential_tasks.settings.drag') %>" style="cursor: grab; color: #94a3b8; margin-right: 4px;">⠿</span>
            <input type="checkbox" name="steps[][status_id]" value="<%= st.id %>" class="sq-use" <%= 'checked' if step %> title="<%= l('sequential_tasks.settings.col_use') %>">
          </td>
          <td style="padding: 6px 12px; text-align: left;">
            <%= st.name %>
            <% unless @workflow_status_ids.include?(st.id) %>
              <em style="color: #c2410c; font-size: 12px;"><%= l('sequential_tasks.settings.not_in_workflow') %></em>
            <% end %>
          </td>
          <td style="padding: 6px 12px;">
            <input type="number" name="steps[][default_duration_days]" value="<%= step&.default_duration_days || 1 %>" min="0" max="365" <%= 'disabled' unless step %> style="width: 80px; padding: 4px; border: 1px solid #cbd5e1; border-radius: 4px; text-align: right;"> <%= l('sequential_tasks.settings.days_unit') %>
          </td>
          <%= render 'color_cell', color: step&.color.presence || '#3498db', disabled: !step %>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div style="margin-top: 25px; padding-top: 15px; border-top: 1px solid #e2e8f0;">
    <%= submit_tag l(:button_save), class: 'button-positive', style: 'padding: 6px 18px; font-weight: bold; cursor: pointer;' %>
    <%= link_to l(:button_cancel), sequential_task_settings_path, style: 'margin-left: 12px; font-size: 12px; color: #64748b;' %>
  </div>
<% end %>

<style>
  #steps-tbody tr.sq-off td:not(:first-child):not(:nth-child(2)) { opacity: 0.35; }
  #steps-tbody tr.sq-off td:nth-child(2) { color: #94a3b8; }
</style>
<script>
  document.getElementById('steps-tbody').addEventListener('change', function (e) {
    if (!e.target.classList.contains('sq-use')) return;
    const row = e.target.closest('tr');
    row.classList.toggle('sq-off', !e.target.checked);
    row.querySelectorAll('input:not(.sq-use), button').forEach(el => { el.disabled = !e.target.checked; });
  });
  (function () { // drag the rows to put the stages in order (the handle starts the drag)
    const tbody = document.getElementById('steps-tbody');
    let dragged = null;
    tbody.addEventListener('mousedown', function (e) {
      const row = e.target.closest('tr');
      if (row) row.draggable = !!e.target.closest('.sq-handle');
    });
    tbody.addEventListener('dragstart', function (e) { dragged = e.target.closest('tr'); e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', ''); }); // Firefox starts no drag without data
    tbody.addEventListener('mouseup', function () { tbody.querySelectorAll('tr[draggable=true]').forEach(r => { r.draggable = false; }); });
    tbody.addEventListener('dragover', function (e) {
      const row = e.target.closest('tr');
      if (!dragged || !row || row === dragged) return;
      e.preventDefault();
      const after = e.clientY > row.getBoundingClientRect().top + row.offsetHeight / 2;
      tbody.insertBefore(dragged, after ? row.nextSibling : row);
    });
    tbody.addEventListener('dragend', function () { if (dragged) dragged.draggable = false; dragged = null; });
  })();
  document.getElementById('steps-tbody').addEventListener('click', function (e) {
    const sw = e.target.closest('.sq-swatch');
    if (!sw) return;
    const cell = sw.closest('td');
    cell.querySelector('input[type=color]').value = sw.dataset.color;
    cell.querySelectorAll('.sq-swatch').forEach(b => { b.style.borderColor = b === sw ? '#0f172a' : 'transparent'; });
  });
  let previewStyle = document.getElementById('bar_style').value; // 'bold' or 'subtle': the look of the bars on the timeline

  function renderPreview() { // the stages as bars of the timeline (the real classes): done, current, then planned
    const box = document.getElementById('sq-preview');
    box.className = 'sq-style-' + previewStyle; // the styles are scoped to #sq-root .sq-style-*
    box.textContent = '';
    document.querySelectorAll('#sq-preview-style button').forEach(b => {
      const on = b.dataset.style === previewStyle;
      b.style.background = on ? '#e2e8f0' : '#fff';
      b.style.fontWeight = on ? 'bold' : 'normal';
    });
    const rows = Array.from(document.querySelectorAll('#steps-tbody tr')).filter(r => r.querySelector('.sq-use').checked);
    if (!rows.length) {
      const em = document.createElement('em');
      em.style.color = '#94a3b8';
      em.textContent = box.dataset.empty;
      box.appendChild(em);
      return;
    }
    rows.forEach((row, i) => {
      const label = row.children[1].firstChild.textContent.trim();
      const bar = document.createElement('div');
      bar.className = 'sq-bar sq-bar-' + (i === 0 ? 'done' : i === 1 ? 'cur' : 'future');
      bar.style.cssText = '--c:' + row.querySelector('input[type=color]').value + '; position: static; width: auto; padding: 0 10px; flex: none;';
      bar.title = label + ' ' + box.dataset.days.replace('__N__', row.querySelector('input[type=number]').value);
      bar.textContent = label;
      box.appendChild(bar);
    });
  }
  document.getElementById('sq-preview-style').addEventListener('click', function (e) {
    const b = e.target.closest('button');
    if (!b) return;
    previewStyle = b.dataset.style;
    document.getElementById('bar_style').value = previewStyle; // saved with the form
    renderPreview();
  });
  document.getElementById('steps-tbody').addEventListener('input', renderPreview);
  document.getElementById('steps-tbody').addEventListener('change', renderPreview);
  document.getElementById('steps-tbody').addEventListener('dragend', renderPreview);
  document.getElementById('steps-tbody').addEventListener('click', function () { setTimeout(renderPreview, 0); });
  renderPreview();
</script>
